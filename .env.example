# OmniPlay-MC root environment template.
# Copy to `.env` and fill in. The brain loads both `./brain/.env` and `./.env`.

# ---- LLM ----
OPENAI_API_KEY=
GPT_MODEL=gpt-5.5
GPT_REASONING_EFFORT=medium
GPT_EMBED_MODEL=text-embedding-3-small

# ---- Voice (optional; if unset, narrator runs disabled) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- Convex (optional locally; required for the public dashboard) ----
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ---- Minecraft ----
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=Voyager
MINECRAFT_VERSION=1.20.4

# ---- Local storage ----
CHROMA_DIR=.chroma
OMNIPLAY_LOCAL_MEMORY=.omniplay-memory
OMNIPLAY_NARRATION_DIR=outputs/narration
MAX_CYCLES=50

# ---- Bridge / viewer ----
VIEWER_PORT=3007
VIEWER_FIRST_PERSON=true
BRIDGE_REQUEST_TIMEOUT=120
